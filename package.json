    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-lazy-load-image-component": "^1.6.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "husky": "^9.1.7",
