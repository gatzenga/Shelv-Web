{
  "name": "shelv-web",
  "license": "GPL-3.0-only",
  "private": true,
  "version": "1.0.1",
  "description": "Web player for Navidrome, the web counterpart of the Shelv apps",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json && tsc -p server/tsconfig.json && vite build",
    "start": "node server/index.ts",
    "lint": "biome lint",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --test \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "lint:fix": "biome lint --write",
    "lint:check": "biome check --write",
    "lint:format": "biome format --write",
    "prepare": "husky"
  },
